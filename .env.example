# Copia a .env y rellena con los valores de tu proyecto Supabase (Settings → API).
# Nunca commitees .env — ya está en .gitignore.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo para supabase/functions (secretos de servidor, nunca en el bundle del cliente):
#   npx supabase secrets set NVIDIA_API_KEY=nvapi-...
# NVIDIA_API_KEY se lee vía Deno.env — no hace falta aquí.
